{
  "name": "@lineage/core",
  "version": "0.1.0",
  "description": "Content-addressed versioning engine for research artifacts: commits, branches, semantic diff and 3-way merge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "diff": "^8.0.2",
    "node-diff3": "^3.1.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
